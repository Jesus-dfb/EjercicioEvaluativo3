<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Monumentos de Málaga</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Leaflet -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  />

  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body>
  <div class="container-fluid vh-100 d-flex flex-column p-0">
    <header class="bg-primary text-white px-3 py-2 d-flex justify-content-between align-items-center">
      <h1 class="h2 m-0">Monumentos de Málaga</h1>

      <div class="d-flex align-items-center gap-2">
        <span id="userStatus" class="small fw-bold"></span>
        <button id="btnLogin" class="btn btn-light">Login</button>
        <button id="btnLogout" class="btn btn-dark d-none">Logout</button>
      </div>
    </header>

    <main class="flex-grow-1 overflow-hidden">
      <div class="row g-0 h-100">
        <div class="col-md-9 col-12 h-100">
          <div id="map" class="h-100"></div>
        </div>

        <aside class="col-md-3 col-12 h-100 border-start bg-white d-flex flex-column">

          <div id="placesList" class="list-group list-group-flush flex-grow-1 overflow-auto"></div>
        </aside>
      </div>
    </main>

    <footer class="bg-primary text-white text-center py-1 small">
      Examen de Jesús - 2DAW - Málaga
    </footer>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- Leaflet -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script src="/javascripts/script.js"></script>
</body>
</html>